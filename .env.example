# VibeGuard Environment Variables

# Server Config
PORT=3000
NODE_ENV=development

# Database Config
DATABASE_URL="postgresql://postgres:password@localhost:5432/vibeguard?schema=public"

# AI Provider (Optional)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Security
JWT_SECRET=your_jwt_secret_here
